# Настройки для сервера. Скопируйте в /srv/makao/.env и заполните.
# Секретный ключ: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=вставьте-сюда-длинный-случайный-ключ
DEBUG=False

SITE_URL=https://example.ru
ALLOWED_HOSTS=example.ru,www.example.ru
CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru
# Сайт за Caddy: адрес посетителя — из заголовка X-Forwarded-For
BEHIND_PROXY=True

# Админка: ОБЯЗАТЕЛЬНО свой пароль. С паролем admin сайт не запустится.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=придумайте-длинный-пароль
ADMIN_EMAIL=

# Telegram (необязательно): уведомления «Новая заявка №N» без персональных данных
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW=600
