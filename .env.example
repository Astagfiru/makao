# Образец настроек. При первом запуске manage.py сам копирует его в .env (с новым SECRET_KEY).
# На сервере: DEBUG=False, свой пароль админки, свой домен (см. README, раздел «Деплой»).

# Секретный ключ Django. Пустой — подставится случайный при создании .env.
SECRET_KEY=
# True — режим разработки на своём компьютере. На сервере обязательно False.
DEBUG=True

# Адрес сайта без слэша в конце: для ссылок в Telegram, sitemap и canonical.
SITE_URL=http://localhost:3000
# Через запятую. На сервере: ваш-домен.ru,www.ваш-домен.ru
ALLOWED_HOSTS=localhost,127.0.0.1
# На сервере: https://ваш-домен.ru,https://www.ваш-домен.ru
CSRF_TRUSTED_ORIGINS=

# Админка /admin/. ВНИМАНИЕ: перед запуском в интернете смените пароль!
# При DEBUG=False и пароле admin сайт откажется запускаться.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=

# Уведомления о заявках в Telegram (без персональных данных). Пусто — отправка пропускается.
# Как получить токен и chat_id — README, раздел «Telegram-бот».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Отдавать загруженные файлы (/media/) самим Django. На сервере их отдаёт Caddy — оставьте пустым.
SERVE_MEDIA=

# Защита формы: не больше LEAD_RATE_LIMIT заявок за LEAD_RATE_WINDOW секунд с одного адреса.
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW=600
